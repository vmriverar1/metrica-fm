rules_version = '2';

// Reglas de seguridad para Firebase Storage - Métrica FM
// Sistema dual: local + Firebase Storage
// Imágenes: lectura pública, escritura solo desde el servidor (Admin SDK)
// Postulaciones: escritura pública validada (tamaño + tipo), protegida por reCAPTCHA en el frontend

service firebase.storage {
  match /b/{bucket}/o {

    // Máximo 5MB, alineado con FILE_CONFIG.MAX_SIZE de src/lib/storage/file-upload-service.ts
    function isValidSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    // Solo PDF, DOC y DOCX, alineado con FILE_CONFIG.ALLOWED_TYPES
    function isValidDocumentType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Carpeta de imágenes de proyectos
    match /images/proyectos/{allPaths=**} {
      // Permitir lectura pública (necesario para mostrar en el sitio web)
      allow read: if true;

      // Solo el servidor puede escribir (Firebase Admin SDK no requiere autenticación)
      allow write: if false;
    }

    // Carpeta de imágenes generales
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // CVs de postulaciones laborales
    // Formato: job-applications/{jobId}/{fileType}_{timestamp}_{filename}
    match /job-applications/{jobId}/{filename} {
      // Escritura pública: el postulante no tiene cuenta. La seguridad se apoya en
      // validación de tamaño, validación de tipo y reCAPTCHA en el formulario.
      allow write: if isValidSize() && isValidDocumentType();

      // Lectura para obtener la URL de descarga tras el upload. Los nombres llevan
      // timestamp + random, así que no son descubribles sin la URL exacta.
      allow read: if true;
    }

    // Por defecto, denegar todo acceso a otras rutas
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
